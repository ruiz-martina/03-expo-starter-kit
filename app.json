{
  "expo": {
    "name": "Bar Salesiano",
    "slug": "bar-salesiano",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "barsalesiano",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FDE047"
        }
      ]
    ],
    "extra": {
      "school": "Unidad Educativa Tecnico Salesiano",
      "module": "Programacion Movil 3 BGU",
      "teacher": "Ing. Milton Velasquez",
      "year": "2026-2027"
    }
  }
}
